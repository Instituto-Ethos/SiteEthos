php_value upload_max_filesize 2000M
php_value post_max_size 2000M
LimitRequestBody 102400000000

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Pass Basic-auth Authorization header through to PHP (required by the
# Getnet webhook REST route) — standard fix for Apache + mod_php setups.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^wp-content\/uploads\/?(.*)$ "https\:\/\/ethos.org.br\/wp-content\/uploads\/$1" [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
